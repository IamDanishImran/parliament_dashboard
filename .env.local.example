# Copy this file to .env.local and fill in real values (do NOT commit .env.local)

# Supabase public keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SMTP credentials for sending verification emails (e.g. Mailtrap, Gmail app password)
EMAIL_USER=you@example.com
EMAIL_PASS=your-email-password-or-app-password

# Optional: Supabase service role key (only for server-side scripts, keep secret)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string for SQL scripts (used by npm run db:reseed)
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
